{
  "name": "pickoneq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "tsc --noEmit",
    "android:release": "npm --prefix tools/android-release run open",
    "android:release:build": "npm --prefix tools/android-release run build",
    "android:apk": "npm --prefix tools/android-release run build:apk",
    "android:remote-apk": "npm --prefix tools/android-release run build:remote-apk"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@napi-rs/keyring": "^1.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
