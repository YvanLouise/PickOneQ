{
  "name": "pickoneq-android-release",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node ./scripts/build-server.mjs",
    "open": "node ./scripts/open-web.js",
    "build": "tsc -b && vite build",
    "build:apk": "node --env-file-if-exists=../../.env ./scripts/build-local-apk.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
}
